rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function member() {
   return request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid))
    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.enabled == true;
  }
  // Account managers (users/{uid}.canManageMembership == true) read the account list.
  // Account writes (PR-A, docs/ACCOUNTS.md) are allowed ONLY through the guarded paths below:
  //  - a ledger accessControl/admins (adminUids) mirrors "enabled && canManageMembership" and is created
  //    by a trusted Admin script (clients can never create/delete it);
  //  - an admin edits another user's enabled/admin/displayName in ONE batch with the ledger (when the
  //    admin state flips) and an append-only auditLogs/account-{uid}-{accessVersion};
  //  - an admin creates a NEW users/{uid} (VIEWER only, mustChangePassword) in one batch with
  //    auditLogs/account-{uid}-1 (ACCOUNT_CREATED); the e-mail invitation flow was removed.
  // Access budget: every operation stays <= 6 distinct documents (limit 10/op, 20/batch).
  function manager() {
   return member() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.canManageMembership == true;
  }
  function userDoc(id) { return /databases/$(database)/documents/users/$(id); }
  function ledgerPath() { return /databases/$(database)/documents/accessControl/admins; }
  function accountAuditDoc(id) { return /databases/$(database)/documents/auditLogs/$(id); }
  function isAdminUser(u) {
   return u.get('enabled', false) == true && u.get('canManageMembership', false) == true;
  }
  // Ledger-backed admin: the users flag AND the ledger entry must agree (a half-granted admin does nothing).
  function ledgerAdmin() {
   return manager() && request.auth.uid in get(ledgerPath()).data.adminUids;
  }
  function nameOk(n) { return n is string && n.matches('[^\\x00-\\x1f\\x7f]{1,120}'); }
  function ledgerChanged(uid, nowAdmin) {
   let l0 = get(ledgerPath()).data;
   let l1 = getAfter(ledgerPath()).data;
   return l1.version == l0.version + 1 && l1.lastTargetUid == uid
    && l1.adminUids == (nowAdmin ? l0.adminUids.concat([uid]) : l0.adminUids.removeAll([uid]));
  }
  function ledgerUntouched() {
   return getAfter(ledgerPath()).data.version == get(ledgerPath()).data.version;
  }
  function accountUpdateOk(uid) {
   let b = resource.data;
   let a = request.resource.data;
   let v = a.accessVersion;
   let audit = accountAuditDoc('account-' + uid + '-' + string(v));
   return ledgerAdmin() && uid != request.auth.uid
    && a.diff(b).affectedKeys().hasOnly(['enabled', 'canManageMembership', 'displayName', 'accessVersion',
        'updatedBy', 'updatedAt', 'approvedBy', 'approvedAt', 'disabledBy', 'disabledAt'])
    && v is int && v == b.get('accessVersion', 0) + 1
    && a.updatedBy == request.auth.uid && a.updatedAt == request.time
    && (!a.diff(b).affectedKeys().hasAny(['approvedBy']) || a.approvedBy == request.auth.uid)
    && (!a.diff(b).affectedKeys().hasAny(['disabledBy']) || a.disabledBy == request.auth.uid)
    && (!a.diff(b).affectedKeys().hasAny(['approvedAt']) || a.approvedAt == request.time)
    && (!a.diff(b).affectedKeys().hasAny(['disabledAt']) || a.disabledAt == request.time)
    && a.enabled is bool && a.canManageMembership is bool
    && (a.canManageMembership == false || a.enabled == true)
    && (!('displayName' in a) || nameOk(a.displayName))
    && (isAdminUser(b) != isAdminUser(a) ? ledgerChanged(uid, isAdminUser(a)) : ledgerUntouched())
    && existsAfter(audit) && getAfter(audit).data.actorUid == request.auth.uid;
  }
  // Admin-created account (docs/ACCOUNTS.md): a ledger admin creates users/{uid} for a NEW uid in one batch with
  // auditLogs/account-{uid}-1 (ACCOUNT_CREATED). VIEWER only; the first password is chosen by the app and must be changed
  // at first sign-in (mustChangePassword). Rules cannot verify the uid exists in Auth; a stray doc for a random uid grants
  // nobody access because no Auth user can ever sign in with that uid.
  function adminCreateOk(uid) {
   let d = request.resource.data;
   let audit = getAfter(accountAuditDoc('account-' + uid + '-1')).data;
   return ledgerAdmin() && uid != request.auth.uid && !exists(userDoc(uid))
    && d.keys().hasOnly(['enabled', 'roleIds', 'canManageMembership', 'canReviewChanges', 'accessVersion',
        'schemaVersion', 'email', 'displayName', 'approvedBy', 'approvedAt', 'createdVia', 'mustChangePassword'])
    && d.enabled == true && d.roleIds == ['member'] && d.canManageMembership == false
    && d.get('canReviewChanges', false) == false
    && d.accessVersion == 1 && d.schemaVersion == 1
    && d.email is string && d.email == d.email.lower() && d.email.size() <= 254 && d.email.matches('[!-~]+@[!-~]+')
    && (!('displayName' in d) || nameOk(d.displayName))
    && d.approvedBy == request.auth.uid && d.approvedAt == request.time
    && d.createdVia in ['phone', 'email'] && d.mustChangePassword == true
    && existsAfter(accountAuditDoc('account-' + uid + '-1'))
    && audit.event == 'ACCOUNT_CREATED' && audit.actorUid == request.auth.uid && audit.targetUid == uid;
  }
  // The signed-in user clears their own mustChangePassword after changing the password (client-enforced, not a
  // security boundary: it only controls the forced-change screen).
  function passwordChangedOk(uid) {
   let b = resource.data;
   let a = request.resource.data;
   return request.auth != null && request.auth.uid == uid && b.get('mustChangePassword', false) == true
    && a.diff(b).affectedKeys().hasOnly(['mustChangePassword', 'passwordChangedAt'])
    && a.mustChangePassword == false && a.passwordChangedAt == request.time;
  }
  match /users/{uid} {
   allow get: if request.auth != null && (request.auth.uid == uid || manager());
   allow list: if manager();
   allow update: if accountUpdateOk(uid);
   allow update: if passwordChangedOk(uid);
   allow create: if adminCreateOk(uid);
  }
  // Admin ledger: only updates, one uid per change, version + 1, never below one admin. It can change ONLY in the
  // batch that flips users/{target}'s admin state (get != getAfter) with the matching ACCOUNT_UPDATED audit, so it
  // cannot drift from users/{uid}. Repairing an already drifted ledger is the Admin script's job (later PR).
  function ledgerUpdateOk() {
   let b = resource.data;
   let a = request.resource.data;
   let t = a.lastTargetUid;
   return a.keys().hasOnly(['adminUids', 'version', 'lastTargetUid', 'schemaVersion'])
    && a.schemaVersion == 1 && a.version is int && a.version == b.version + 1
    && t is string && t.size() > 0 && t != request.auth.uid
    && a.adminUids is list && a.adminUids.size() >= 1 && a.adminUids.size() <= 20
    && existsAfter(accountAuditDoc('account-' + t + '-' + string(getAfter(userDoc(t)).data.accessVersion)))
    && ((!(t in b.adminUids) && a.adminUids == b.adminUids.concat([t])
         && !isAdminUser(get(userDoc(t)).data) && isAdminUser(getAfter(userDoc(t)).data))
     || (t in b.adminUids && a.adminUids == b.adminUids.removeAll([t])
         && isAdminUser(get(userDoc(t)).data) && !isAdminUser(getAfter(userDoc(t)).data)));
  }
  match /accessControl/{id} {
   allow get: if id == 'admins' && manager();
   allow update: if id == 'admins' && ledgerAdmin() && ledgerUpdateOk();
  }
  // Account audit events (kept out of auditCreateOk so the edit-N branch stays untouched).
  function accountAuditOk(id) {
   let d = request.resource.data;
   return d.schemaVersion == 1 && d.timestamp == request.time && d.actorUid == request.auth.uid
    && ((d.event == 'ACCOUNT_UPDATED' && accountUpdatedAuditOk(id, d))
     || (d.event == 'ACCOUNT_CREATED' && ledgerAdmin()
         && d.keys().hasOnly(['event', 'actorUid', 'targetUid', 'accessVersion', 'timestamp', 'schemaVersion'])
         && d.targetUid is string && d.targetUid != request.auth.uid && d.accessVersion == 1
         && id == 'account-' + d.targetUid + '-1'
         && !exists(userDoc(d.targetUid)) && existsAfter(userDoc(d.targetUid))));
  }
  // ACCOUNT_UPDATED carries only enabled/admin flags (never a name or e-mail) and must match the real change.
  function accountUpdatedAuditOk(id, d) {
   let tb = get(userDoc(d.targetUid)).data;
   let ta = getAfter(userDoc(d.targetUid)).data;
   return ledgerAdmin()
    && d.keys().hasOnly(['event', 'actorUid', 'targetUid', 'accessVersion', 'fields', 'before', 'after', 'timestamp', 'schemaVersion'])
    && d.targetUid is string && d.targetUid != request.auth.uid
    && d.accessVersion is int && d.accessVersion == ta.accessVersion
    && ta.accessVersion == tb.get('accessVersion', 0) + 1
    && id == 'account-' + d.targetUid + '-' + string(d.accessVersion)
    && d.fields is list && d.fields.hasOnly(['enabled', 'admin', 'displayName'])
    && d.before is map && d.after is map
    && d.before.keys().hasOnly(['enabled', 'admin']) && d.after.keys().hasOnly(['enabled', 'admin'])
    && d.before.enabled == tb.get('enabled', false) && d.before.admin == isAdminUser(tb)
    && d.after.enabled == ta.enabled && d.after.admin == isAdminUser(ta)
    && ('enabled' in d.fields) == (d.before.enabled != d.after.enabled)
    && ('admin' in d.fields) == (d.before.admin != d.after.admin)
    && ('displayName' in d.fields) == (tb.get('displayName', null) != ta.get('displayName', null));
  }
  // --- In-app edits (admin = manager) ---------------------------------------------------------
  // Every edit is ONE atomic batch that must carry an append-only auditLogs/edit-{editVersion} and a
  // treeSnapshots/main update (editVersion + 1). The audit id is derived from the version, so a second
  // writer racing on the same version fails (the audit doc already exists) and no edit is unlogged.
  //  - PERSON_EDITED: persons/{id} + memberProfiles/{id} (profileVersion + 1) [+ personPrivate].
  //  - PERSON_ADDED : new persons/memberProfiles [+ personPrivate] + relations (listed in the audit).
  //  - SPOUSE_ADDED : unions/{unionId} [+ a new person listed in the audit's createdPersonIds].
  //  - PARENT_REVERTED: undo the LATEST parent replacement of a role: the replaced relation (listed in relationIds) is
  //    revived with replacedBy cleared, the replacing one (removedRelationIds) is hidden; revertsVersion = the
  //    PARENT_CHANGED audit that made it (must equal the hidden relation's sourceRefs).
  //  - PARENT_REMOVED: hide ONE non-lineage parent relation (removedRelationIds, deleted + removedAtVersion == n);
  //    PARENT_REMOVAL_UNDONE: bring it back (relationIds, revertsVersion = the PARENT_REMOVED audit, removedAtVersion
  //    must equal it and is cleared). A removed relation is never revived by any other flow (removedAtVersion != null).
  //  - UNION_REMOVED: hide ONE spouse link entered by mistake (unions/{unionId}: deleted + removedAtVersion == n, deletedWith
  //    cleared); UNION_REMOVAL_UNDONE brings it back (revertsVersion = the UNION_REMOVED audit == removedAtVersion, cleared on
  //    restore, both people must be live). Exactly three writes: the union, treeSnapshots/main and the audit; persons,
  //    memberProfiles and relations are untouched. A removed union is never revived by PERSON_RESTORED (removedAtVersion != null).
  //  - PERSON_DELETED / PERSON_RESTORED: soft delete (persons.deleted, its parent relations and up to six
  //    unions: unionId + moreUnionIds, each proven written in the same batch by auditCreateOk); memberProfiles is deleted (hidden from members) and recreated on restore.
  // Rules cannot parse the snapshot JSON, so its content stays the trusted client's (applyEdit/applyAdd)
  // job; the snapshot rule only proves that the matching canonical docs are created/bumped in the batch.
  function snapshotPath() { return /databases/$(database)/documents/treeSnapshots/main; }
  function nextEditVersion() { return get(snapshotPath()).data.get('editVersion', 0) + 1; }
  function auditData(n) {
   return getAfter(/databases/$(database)/documents/auditLogs/$('edit-' + string(n))).data;
  }
  function personDoc(id) { return /databases/$(database)/documents/persons/$(id); }
  function profileDoc(id) { return /databases/$(database)/documents/memberProfiles/$(id); }
  function relationDoc(id) { return /databases/$(database)/documents/relations/$(id); }
  function unionDoc(id) { return /databases/$(database)/documents/unions/$(id); }
  function bumps(path) { return getAfter(path).data.profileVersion == get(path).data.profileVersion + 1; }
  function editGate(personId) {
   let n = nextEditVersion();
   let a = auditData(n);
   return manager()
    && getAfter(snapshotPath()).data.editVersion == n
    && a.actorUid == request.auth.uid
    && a.event == 'PERSON_EDITED'
    && a.personId == personId;
  }
  function createGate(personId) {
   let n = nextEditVersion();
   let a = auditData(n);
   return manager()
    && getAfter(snapshotPath()).data.editVersion == n
    && a.actorUid == request.auth.uid
    && a.event in ['PERSON_ADDED', 'SPOUSE_ADDED']
    && personId.matches('[A-Za-z0-9_-]{1,100}')
    && personId in a.createdPersonIds;
  }
  function snapshotUpdateOk(n) {
   let a = auditData(n);
   return a.actorUid == request.auth.uid
    && ((a.event == 'PERSON_EDITED' && bumps(personDoc(a.personId)) && bumps(profileDoc(a.personId)))
     || (a.event == 'PERSON_ADDED'
         && !exists(personDoc(a.personId)) && existsAfter(personDoc(a.personId))
         && !exists(relationDoc(a.relationIds[0]))
         && getAfter(relationDoc(a.relationIds[0])).data.childId == a.personId)
     || (a.event == 'SPOUSE_ADDED'
         && !exists(unionDoc(a.unionId)) && existsAfter(unionDoc(a.unionId)))
     || (a.event == 'PARENT_CHANGED'
         && !exists(relationDoc(a.relationIds[0]))
         && getAfter(relationDoc(a.relationIds[0])).data.childId == a.personId
         && (a.removedRelationIds.size() == 0
             || (get(relationDoc(a.removedRelationIds[0])).data.get('deleted', false) == false
                 && getAfter(relationDoc(a.removedRelationIds[0])).data.get('deleted', false) == true)))
     || (a.event == 'PARENT_REVERTED'
         && get(relationDoc(a.relationIds[0])).data.get('deleted', false) == true
         && getAfter(relationDoc(a.relationIds[0])).data.get('deleted', false) == false
         && getAfter(relationDoc(a.removedRelationIds[0])).data.get('revertedAtVersion', null) == n)
     || (a.event == 'PARENT_REMOVED'
         && get(relationDoc(a.removedRelationIds[0])).data.get('deleted', false) == false
         && getAfter(relationDoc(a.removedRelationIds[0])).data.get('deleted', false) == true
         && getAfter(relationDoc(a.removedRelationIds[0])).data.get('removedAtVersion', null) == n)
     || (a.event == 'PARENT_REMOVAL_UNDONE'
         && get(relationDoc(a.relationIds[0])).data.get('deleted', false) == true
         && getAfter(relationDoc(a.relationIds[0])).data.get('deleted', false) == false
         && getAfter(relationDoc(a.relationIds[0])).data.get('restoredAt', null) == request.time)
     || (a.event == 'RELATION_TYPE_CHANGED'
         && getAfter(relationDoc(a.relationIds[0])).data.version == get(relationDoc(a.relationIds[0])).data.version + 1)
     || (a.event == 'PERSON_DELETED'
         && get(personDoc(a.personId)).data.get('deleted', false) == false
         && getAfter(personDoc(a.personId)).data.deleted == true
         && exists(profileDoc(a.personId)) && !existsAfter(profileDoc(a.personId))
         && (a.relationIds.size() == 0 || getAfter(relationDoc(a.relationIds[0])).data.get('deleted', false) == true)
         && (a.get('unionId', null) == null || getAfter(unionDoc(a.unionId)).data.get('deleted', false) == true))
     || (a.event == 'PERSON_RESTORED'
         && get(personDoc(a.personId)).data.get('deleted', false) == true
         && getAfter(personDoc(a.personId)).data.deleted == false
         && !exists(profileDoc(a.personId)) && existsAfter(profileDoc(a.personId))
         && (a.relationIds.size() == 0 || getAfter(relationDoc(a.relationIds[0])).data.get('deleted', false) == false)
         && (a.get('unionId', null) == null || getAfter(unionDoc(a.unionId)).data.get('deleted', false) == false))
     || (a.event == 'UNION_REMOVED'
         && get(unionDoc(a.unionId)).data.get('deleted', false) == false
         && getAfter(unionDoc(a.unionId)).data.get('deleted', false) == true
         && getAfter(unionDoc(a.unionId)).data.get('removedAtVersion', null) == n)
     || (a.event == 'UNION_REMOVAL_UNDONE'
         && get(unionDoc(a.unionId)).data.get('deleted', false) == true
         && getAfter(unionDoc(a.unionId)).data.get('deleted', false) == false
         && getAfter(unionDoc(a.unionId)).data.get('restoredAt', null) == request.time));
  }
  function lifecycleGate(personId, ev) {
   let n = nextEditVersion();
   let a = auditData(n);
   return manager()
    && getAfter(snapshotPath()).data.editVersion == n
    && a.actorUid == request.auth.uid
    && a.event == ev
    && a.personId == personId;
  }
  function profileShapeOk() {
   let d = request.resource.data;
   return d.keys().hasOnly(['displayName', 'normalizedName', 'profileVersion', 'schemaVersion', 'birthYear', 'deathYear'])
    && d.displayName is string && d.displayName.size() > 0 && d.displayName.size() <= 120
    && d.normalizedName is string && d.normalizedName.size() <= 240
    && d.schemaVersion == 1
    && d.get('birthYear', 1000) is int && d.get('deathYear', 1000) is int
    && d.get('birthYear', 1000) >= 1000 && d.get('birthYear', 1000) <= 2200
    && d.get('deathYear', 1000) >= 1000 && d.get('deathYear', 1000) <= 2200;
  }
  function relationCreateOk(id) {
   let n = nextEditVersion();
   let a = auditData(n);
   let d = request.resource.data;
   return manager()
    && getAfter(snapshotPath()).data.editVersion == n
    && a.actorUid == request.auth.uid && a.event in ['PERSON_ADDED', 'PARENT_CHANGED']
    && d.keys().hasOnly(['parentId', 'childId', 'parentRole', 'relationType', 'lineageTransmission',
        'verificationStatus', 'version', 'schemaVersion', 'sourceRefs', 'createdAt'])
    && d.parentId is string && d.parentId != d.childId && d.childId == a.personId && id in a.relationIds
    && id == 'r-' + d.parentId + '-' + d.childId
    && exists(personDoc(d.parentId)) && get(personDoc(d.parentId)).data.get('deleted', false) == false
    && d.parentRole in ['FATHER', 'MOTHER'] && d.relationType in ['BIOLOGICAL', 'ADOPTIVE']
    && d.lineageTransmission == (d.parentRole == 'FATHER'
        && getAfter(personDoc(d.childId)).data.category == 'CLAN')
    && d.verificationStatus == 'APPROVED'
    && d.version == 1 && d.schemaVersion == 1 && d.createdAt == request.time
    && d.sourceRefs == ['auditLogs/edit-' + string(n)];
  }
  function unionCreateOk(id) {
   let n = nextEditVersion();
   let a = auditData(n);
   let d = request.resource.data;
   return manager()
    && getAfter(snapshotPath()).data.editVersion == n
    && a.actorUid == request.auth.uid && a.event == 'SPOUSE_ADDED' && id == a.unionId
    && d.keys().hasOnly(['partnerIds', 'order', 'status', 'note', 'sourceRefs', 'schemaVersion', 'createdAt'])
    && d.partnerIds is list && d.partnerIds.size() == 2 && a.personId in d.partnerIds
    && d.partnerIds[0] is string && d.partnerIds[1] is string && d.partnerIds[0] != d.partnerIds[1]
    && id == (d.partnerIds[0] < d.partnerIds[1]
        ? 'u-' + d.partnerIds[0] + '-' + d.partnerIds[1]
        : 'u-' + d.partnerIds[1] + '-' + d.partnerIds[0])
    && existsAfter(personDoc(d.partnerIds[0])) && existsAfter(personDoc(d.partnerIds[1]))
    && getAfter(personDoc(d.partnerIds[0])).data.get('deleted', false) == false
    && getAfter(personDoc(d.partnerIds[1])).data.get('deleted', false) == false
    && (d.order == null || (d.order is string && d.order.size() <= 20))
    && d.schemaVersion == 1 && d.createdAt == request.time
    && d.sourceRefs == ['auditLogs/edit-' + string(n)];
  }
  // Trusted backend publishes only allowlisted basic fields here.
  match /memberProfiles/{id} {
   allow read: if member();
   // Members see only name and birth/death years (decision 2026-11-11): strict allowlist.
   allow update: if editGate(id) && request.resource.data.profileVersion is int
    && request.resource.data.profileVersion == resource.data.profileVersion + 1 && profileShapeOk();
   allow create: if createGate(id) && !exists(personDoc(id))
    && request.resource.data.profileVersion == 1 && profileShapeOk();
   // Restore: recreate the member copy; its version continues the person's (persons is bumped in the same batch).
   allow create: if lifecycleGate(id, 'PERSON_RESTORED') && exists(personDoc(id))
    && request.resource.data.profileVersion == getAfter(personDoc(id)).data.profileVersion
    && request.resource.data.displayName == get(personDoc(id)).data.displayName
    && profileShapeOk();
   allow delete: if lifecycleGate(id, 'PERSON_DELETED');
  }
  // One versioned snapshot (names, birth/death years, generation, branch, relations). get only:
  // no listing. Clients may only update data + editVersion, one version at a time, with an audit.
  match /treeSnapshots/{id} {
   allow get: if member();
   allow update: if id == 'main' && manager()
    && request.resource.data.editVersion is int
    && request.resource.data.editVersion == nextEditVersion()
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['data', 'editVersion'])
    && request.resource.data.data is string && request.resource.data.data.size() < 900000
    && snapshotUpdateOk(request.resource.data.editVersion);
  }
  match /auditLogs/{id} {
   // Account audits stay closed to every client; managers read only edit audits, by id.
   allow get: if manager()
    && resource.data.event in ['PERSON_EDITED', 'PERSON_ADDED', 'SPOUSE_ADDED', 'PARENT_CHANGED', 'PARENT_REVERTED', 'PARENT_REMOVED', 'PARENT_REMOVAL_UNDONE', 'RELATION_TYPE_CHANGED', 'PERSON_DELETED', 'PERSON_RESTORED', 'UNION_REMOVED', 'UNION_REMOVAL_UNDONE'];
   allow create: if manager() && auditCreateOk(id);
   allow create: if accountAuditOk(id);
  }
  // The first union (audit.unionId) plus up to five extra ones. Each listed union must have been written in THIS batch:
  // deletedAt/restoredAt == request.time cannot hold for an untouched doc. Fixed indexes because rules cannot loop;
  // 3 base reads + 6 getAfter (unionId + 5 more) stays at 9, under the 10-access limit of one request.
  function unionWritten(unionId, d) {
   let u = getAfter(unionDoc(unionId)).data;
   return d.event == 'PERSON_DELETED'
    ? (u.get('deleted', false) == true && u.get('deletedAt', null) == request.time && u.get('deletedWith', '') == d.personId)
    : (u.get('deleted', false) == false && u.get('restoredAt', null) == request.time);
  }
  function moreUnionsOk(d) {
   let m = d.get('moreUnionIds', []);
   return m is list && m.size() <= 5
    && (m.size() == 0 || (d.event in ['PERSON_DELETED', 'PERSON_RESTORED'] && d.get('unionId', null) is string))
    && m.toSet().size() == m.size() && !(d.get('unionId', null) in m)
    && (!(d.event in ['PERSON_DELETED', 'PERSON_RESTORED']) || d.get('unionId', null) == null || unionWritten(d.unionId, d))
    && (m.size() < 1 || unionWritten(m[0], d))
    && (m.size() < 2 || unionWritten(m[1], d))
    && (m.size() < 3 || unionWritten(m[2], d))
    && (m.size() < 4 || unionWritten(m[3], d))
    && (m.size() < 5 || unionWritten(m[4], d));
  }
  function auditCreateOk(id) {
   let d = request.resource.data;
   return d.keys().hasOnly(['event', 'actorUid', 'target', 'personId', 'createdPersonIds', 'relationIds',
        'removedRelationIds', 'unionId', 'moreUnionIds', 'revertsVersion', 'editVersion', 'fields', 'before', 'after', 'timestamp', 'schemaVersion'])
    && d.event in ['PERSON_EDITED', 'PERSON_ADDED', 'SPOUSE_ADDED', 'PARENT_CHANGED', 'PARENT_REVERTED',
        'PARENT_REMOVED', 'PARENT_REMOVAL_UNDONE', 'RELATION_TYPE_CHANGED', 'PERSON_DELETED', 'PERSON_RESTORED',
        'UNION_REMOVED', 'UNION_REMOVAL_UNDONE']
    && (d.event in ['PARENT_CHANGED', 'PARENT_REVERTED', 'PARENT_REMOVED'] || d.get('removedRelationIds', []).size() == 0)
